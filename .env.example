# Copy this to .env and fill in your key:
#   cp .env.example .env
#
# Swap providers by changing these three values and restarting.
# No code changes needed.

# FreeRouter (default). Get your key: sign up at https://freerouter.com —
# a starter key is included with every new account.
PROVIDER_BASE_URL=https://api.freerouter.com
PROVIDER_API_KEY=fr_live_paste_yours_here
MODEL=openrouter/free

# Companion Ads (optional, FreeRouter only): set to true to request a
# sponsored slot alongside each reply. Your key needs Companion Ads turned
# on and an ad network configured in the FreeRouter dashboard (see the
# README's Companion Ads section). Keep false when swapped to OpenRouter.
COMPANION_ADS=false

# OpenRouter swap (comment out the FreeRouter lines and use these instead):
# PROVIDER_BASE_URL=https://openrouter.ai/api
# PROVIDER_API_KEY=sk-or-paste_yours_here
# MODEL=openrouter/free

PORT=3000
